# true = local only; false = verify MongoDB and R2
DEMO_MODE=false
APP_CURRENCY=TRY
APP_ORIGIN=https://unihome.up.railway.app/
# Escape literal dollar signs as \$
MONGODB_URI=
MONGODB_DB=
# Account ID only, not an endpoint URL
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Web Push: copy these values from .env.local into Railway Variables
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

